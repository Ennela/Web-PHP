RewriteEngine On

# Chặn tải trực tiếp các file nhạy cảm / cấu hình
<FilesMatch "(^\.env.*|^composer\.(json|lock)$|^Dockerfile$|^docker-entrypoint\.sh$|^README\.md$|\.(sql|md|sh|log|ini)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>


# Redirect to HTTPS (Railway proxies via X-Forwarded-Proto)
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule .* https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# If file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise, route to index.php
RewriteRule ^$ /index.php [L]
