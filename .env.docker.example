# Docker Compose: sao chép file này thành `.env` (cùng thư mục với docker-compose.yml) rồi điền giá trị.
# `.env` đã bị .gitignore và .dockerignore loại trừ — KHÔNG commit. App không đọc file này,
# chỉ Compose đọc rồi truyền biến vào container.
# Lưu ý: file `.env` cũng là file dùng cho chạy local (xem .env.example); đừng trộn hai mục đích.

# Tên miền công khai, KHÔNG có https:// và không có đường dẫn.
APP_DOMAIN=shop.tenmien.com

# Khóa mã hóa dữ liệu cá nhân (32 byte). Sinh bằng:
#   docker compose run --rm --no-deps --entrypoint php app -r "require 'includes/crypto.php'; echo app_generate_encryption_key(), PHP_EOL;"
# hoặc trên máy có PHP:  php -r "require 'includes/crypto.php'; echo app_generate_encryption_key(), PHP_EOL;"
# MẤT KHÓA = MẤT DỮ LIỆU ĐÃ MÃ HÓA. Sao lưu ở nơi thứ hai (trình quản lý mật khẩu).
APP_ENCRYPTION_KEY_ID=k1
APP_ENCRYPTION_KEY=
# Bật = 1 sau khi chạy xong scripts/migrate_crypto_storage.php và đã kiểm thử.
APP_CRYPTO_STRICT_READ=0

# Mật khẩu MySQL (đặt chuỗi dài, ngẫu nhiên, khác nhau). Chỉ có hiệu lực khi volume DB còn trống:
# đổi sau này phải đổi trong MySQL bằng ALTER USER.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Token của tunnel Cloudflare MỚI (Zero Trust > Networks > Tunnels; public hostname trỏ tới http://app:80).
TUNNEL_TOKEN=

# Email (Mailjet) — tùy chọn, không có thì không gửi được email.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Bắt buộc nếu dùng webhook Mailjet, bỏ trống thì webhook trả 503.
MAILJET_WEBHOOK_SECRET=
MAIL_TRANS_FROM_EMAIL=no-reply@tenmien.com
MAIL_TRANS_FROM_NAME=Shop Sneakers
MAIL_MARKETING_FROM_EMAIL=hello@tenmien.com
MAIL_MARKETING_FROM_NAME=Shop Sneakers
MAIL_ADMIN_EMAIL=
MAIL_ADMIN_NAME=Shop Admin
MAIL_UNSUBSCRIBE_URL=

# Thương hiệu (hiện trong email/hóa đơn)
BRAND_NAME=Shop Sneakers
BRAND_LOGO_URL=
BRAND_PHONE=
BRAND_ADDRESS=
BRAND_TAX_ID=

# VNPAY — tùy chọn, bỏ trống thì COD/catalog vẫn chạy.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
