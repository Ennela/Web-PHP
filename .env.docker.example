# Docker Compose: sao chép file này thành `.env.docker` (cùng thư mục với docker-compose.yml) rồi điền giá trị.
# Chạy mọi lệnh với:  docker compose --env-file .env.docker ...
# `.env.docker` đã bị .gitignore và .dockerignore loại trừ — KHÔNG commit. App không đọc file này,
# chỉ Compose đọc rồi truyền biến vào container. (File `.env` là của chạy local, xem .env.example.)

# Tên miền công khai, KHÔNG có https:// và không có đường dẫn.
APP_DOMAIN=shop.tenmien.com

# Khóa mã hóa dữ liệu cá nhân (32 byte). Sinh bằng:
#   docker run --rm -v "${PWD}:/app:ro" -w /app php:8.4-cli php -r "require 'includes/crypto.php'; echo app_generate_encryption_key();"
# (PowerShell, chạy ở thư mục gốc repo) hoặc trên máy có PHP:  php -r "require 'includes/crypto.php'; echo app_generate_encryption_key();"
# MẤT KHÓA = MẤT DỮ LIỆU ĐÃ MÃ HÓA. Sao lưu ở nơi thứ hai (trình quản lý mật khẩu).
APP_ENCRYPTION_KEY_ID=k1
APP_ENCRYPTION_KEY=
# Bật = 1 sau khi chạy xong scripts/migrate_crypto_storage.php và đã kiểm thử.
APP_CRYPTO_STRICT_READ=0

# Mật khẩu MySQL (đặt chuỗi dài, ngẫu nhiên, khác nhau). Chỉ có hiệu lực khi volume DB còn trống:
# đổi sau này phải đổi trong MySQL bằng ALTER USER.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# Token của tunnel Cloudflare MỚI (Zero Trust > Networks > Tunnels; public hostname trỏ tới http://app:80).
TUNNEL_TOKEN=

# Email (Mailjet) — tùy chọn, không có thì không gửi được email.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Bắt buộc nếu dùng webhook Mailjet, bỏ trống thì webhook trả 503.
MAILJET_WEBHOOK_SECRET=
MAIL_TRANS_FROM_EMAIL=no-reply@tenmien.com
MAIL_TRANS_FROM_NAME=Shop Sneakers
MAIL_MARKETING_FROM_EMAIL=hello@tenmien.com
MAIL_MARKETING_FROM_NAME=Shop Sneakers
MAIL_ADMIN_EMAIL=
MAIL_ADMIN_NAME=Shop Admin
MAIL_UNSUBSCRIBE_URL=

# Thương hiệu (hiện trong email/hóa đơn)
BRAND_NAME=Shop Sneakers
BRAND_LOGO_URL=
BRAND_PHONE=
BRAND_ADDRESS=
BRAND_TAX_ID=

# VNPAY — tùy chọn, bỏ trống thì COD/catalog vẫn chạy.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# MoMo — tùy chọn; thiếu 3 khóa đầu thì nút MoMo bị ẩn. Môi trường test: https://test-payment.momo.vn/v2/gateway/api/create
# (khóa test công khai lấy ở tài liệu developers.momo.vn). Production: https://payment.momo.vn/v2/gateway/api/create
# IPN (MoMo gọi về): https://<APP_DOMAIN>/shop/momo_ipn.php — URL này được app tự gửi kèm mỗi giao dịch, không cần đăng ký.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
