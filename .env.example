
# Copy this file to .env for local development only; never commit real secrets.
# Staging/production: set APP_ENV in the process/hosting platform before startup.
# APP_ENV=staging or production disables loading .env from disk.
APP_ENV=local
APP_DEBUG=0
APP_URL=http://127.0.0.1:8000
# Set 1 for local HTTPS. Production/staging always require HTTPS, even if set 0.
# When enabled APP_URL must be an explicit https:// URL. ./run-https.sh sets both.
APP_REQUIRE_HTTPS=0
# Comma-separated trusted hostnames, WITHOUT ports.
APP_TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Empty by default. Trust forwarding headers only from known proxy IPs/CIDRs.
# /0 ranges are rejected. Proxy must always overwrite X-Forwarded-Proto with http or https.
# Requests from trusted proxies without this header are rejected.
TRUSTED_PROXIES=

# ─── Database (provide your own local credentials) ───
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLDATABASE=giaythethao2
MYSQLUSER=root
MYSQLPASSWORD=
# Required for remote MySQL: CA PEM file outside the public document root.
# Optional client certificate/key must be provided together if the server uses mTLS.
# Loopback MySQL (127.0.0.1, ::1, localhost) can omit these for local development.
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

# ─── API Authentication (required to send email) ───
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# ─── VNPAY (optional; COD/catalog work without these values) ───
# Use your own merchant code (4–32 letters/digits) and secret (at least 16 bytes).
# Allowed HTTPS URLs:
# https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# https://pay.vnpay.vn/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ─── Transactional Email (Hóa đơn, OTP, Reset Password) ───
# Gửi tức thì, ưu tiên cao nhất
MAIL_TRANS_FROM_EMAIL=no-reply@yourdomain.com
MAIL_TRANS_FROM_NAME=Shop Sneakers

# ─── Marketing Email (Newsletter, Abandoned Cart, Promotions) ───
# Tốc độ trung bình, bắt buộc có Unsubscribe link
MAIL_MARKETING_FROM_EMAIL=hello@yourdomain.com
MAIL_MARKETING_FROM_NAME=Shop Sneakers

# ─── Admin Notification Email ───
MAIL_ADMIN_EMAIL=admin@example.com
MAIL_ADMIN_NAME=Shop Admin

# ─── Brand Configuration ───
BRAND_NAME=Shop Sneakers
BRAND_URL=https://yourdomain.com
BRAND_LOGO_URL=https://yourdomain.com/assets/images/logo.png
BRAND_PHONE=0394 680 113
BRAND_ADDRESS=Số 6 đường Thắng Lợi 1, Hồng Hà, Hà Nội
BRAND_TAX_ID=0123456789

# Email uses the verified HTTPS Mailjet API. SMTP fallback is not implemented.

# ─── Timeouts & Retry ───
MAIL_CONNECT_TIMEOUT=5
MAIL_TIMEOUT=15
MAIL_MAX_RETRIES=3

# ─── Webhook Secret (bắt buộc; chưa cấu hình thì webhook trả HTTP 503) ───
MAILJET_WEBHOOK_SECRET=

# ─── Unsubscribe URL (cho Marketing emails) ───
MAIL_UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe.php
